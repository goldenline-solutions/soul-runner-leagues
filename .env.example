# Copy to .env for local runs. Never commit .env.
# On Vercel, set these in Project Settings -> Environment Variables instead.

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, your own server).
# Leave blank locally to use the built-in embedded database in ./data/pglite.
DATABASE_URL=

# Commissioner login for Upload Results + the Commissioner's Desk.
ADMIN_PASSWORD=change-me
# Long random string that signs login cookies. Required on Vercel.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Screenshot reading (Upload Results -> "Read a screenshot"). Leave blank for manual entry only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Set to 0 to skip the "is this a real 2K box score?" check (saves one model call per screenshot).
INGEST_VALIDATE=1

# Discord bot (npm run bot). Leave blank if you don't run the bot.
# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token.
DISCORD_TOKEN=
# Your server's id (right-click the server -> Copy Server ID). Commands then show up there at once.
DISCORD_GUILD_ID=
# Public address of the site, used for links in the bot's replies and for Discord login. Example: https://example.com
SITE_URL=

# Scrim queue (see "Scrim queue" in README.md).
# Channel for the pinned live queue message and the private match threads (right-click the channel -> Copy Channel ID).
SCRIM_QUEUE_CHANNEL_ID=
# Role the bot pings when a match is disputed (right-click the role -> Copy Role ID).
SCRIM_ADMIN_ROLE_ID=
# Solo queue (see "Solo queue" in README.md): channel for its live message and match threads.
# Use a different channel from the scrim queue. Players need roles named PG, SG, LOCK, BACKEND or C.
SOLO_QUEUE_CHANNEL_ID=
# Roster commands (see "Roster management" in README.md): the role free agents hold. Optional.
# The bot needs Manage Roles, and its own role must sit above the team roles and this one.
FREE_AGENT_ROLE_ID=
# The four role ids below are optional: /roster autoroles finds them by name and saves them.
# Set one here only to override what it found.
# Who can run every /roster command. Members with Manage Server always can; this role adds more people
# without giving them server permissions.
COMMISSIONER_ROLE_ID=
# Optional server-wide roles the bot gives to team owners and captains set with /roster staff.
OWNER_ROLE_ID=
CAPTAIN_ROLE_ID=
# "Log in with Discord" on the site, so captains can queue from a browser.
# Developer portal -> your app -> OAuth2: copy the Client ID and Client Secret, and add the redirect
# SITE_URL + /api/auth/discord/callback (for example https://example.com/api/auth/discord/callback).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Local server only.
PORT=8787
# Cookies are marked Secure automatically on Vercel. Set to 1 if you serve https some other way.
COOKIE_SECURE=0
