# Copy to .env for local runs. Never commit .env.
# On Vercel, set these in Project Settings -> Environment Variables instead.

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, your own server).
# Leave blank locally to use the built-in embedded database in ./data/pglite.
DATABASE_URL=

# Commissioner login for Upload Results + the Commissioner's Desk.
ADMIN_PASSWORD=change-me
# Long random string that signs login cookies. Required on Vercel.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Screenshot reading (Upload Results -> "Read a screenshot"). Leave blank for manual entry only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Set to 0 to skip the "is this a real 2K box score?" check (saves one model call per screenshot).
INGEST_VALIDATE=1

# Local server only.
PORT=8787
# Cookies are marked Secure automatically on Vercel. Set to 1 if you serve https some other way.
COOKIE_SECURE=0
